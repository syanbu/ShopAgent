DASHSCOPE_API_KEY=
# OpenAI 兼容模式端点，供 openai SDK 调用聊天模型
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# DashScope 原生 SDK 端点，供 dashscope SDK 调用 embedding / rerank
DASHSCOPE_SDK_BASE_URL=https://dashscope.aliyuncs.com/api/v1
CHAT_MODEL=qwen3.7-max
COMPARISON_MODEL=qwen3.6-flash
EVIDENCE_MODEL=qwen3.6-flash
EMBEDDING_MODEL=qwen3.7-text-embedding
RERANK_MODEL=qwen3-rerank
EMBEDDING_DIMENSION=1024
QDRANT_URL=http://127.0.0.1:6333
QDRANT_COLLECTION=product_text_chunks_v1
RETRIEVAL_CHUNK_LIMIT=30
RERANK_PRODUCT_LIMIT=10
FINAL_PRODUCT_LIMIT=3
MODEL_TIMEOUT_SECONDS=30
QDRANT_TIMEOUT_SECONDS=10
DATASET_ROOT=ecommerce_agent_dataset
CONVERSATION_DB_PATH=.data/conversations.sqlite3
PUBLIC_BASE_URL=http://127.0.0.1:8000
